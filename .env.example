# --- API ---
ENV=dev
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720
DATABASE_URL=postgresql+psycopg://peblo:peblo@localhost:5432/peblo
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001,http://localhost:3002

# --- Storage ---
# local (default) or r2
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
DATA_DIR=./data

# Cloudflare R2 — only needed when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=peblo-tv
R2_PUBLIC_BASE_URL=

# --- Seeded CMS users (change these before any shared environment) ---
SEED_ADMIN_EMAIL=admin@peblo.local
SEED_ADMIN_PASSWORD=admin-password
SEED_EDITOR_EMAIL=editor@peblo.local
SEED_EDITOR_PASSWORD=editor-password

# --- Frontends (Vite, build-time) ---
VITE_API_URL=http://localhost:8000
